rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }
    
    function isShopOwner(shopId) {
      return isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // 2. Shops collection (Public info)
    match /shops/{shopId} {
      // Anyone can read approved shops; owners and admin can read their own pending shops
      allow read: if resource.data.status == 'approved' || (isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin()));
      // Shop registration requires auth
      allow create: if isAuthenticated() && request.resource.data.status == 'pending';
      // Only shopkeeper can edit their shop details (cannot change status or verified badge)
      allow update: if (isShopOwner(shopId) && 
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'verified'])) 
                       || isAdmin();
      allow delete: if isAdmin();
    }

    // 3. shopPrivate (CNIC, identity documents - ADMIN ONLY)
    match /shopPrivate/{shopId} {
      allow read, write: if isAdmin();
      // Allow shopkeeper to submit CNIC during shop creation
      allow create: if isAuthenticated();
    }

    // 4. Products collection
    match /products/{productId} {
      // Customers can browse available products from approved shops
      allow read: if resource.data.stockStatus == 'Available' || isAuthenticated();
      // Shopkeeper can create products for their own approved shop
      allow create: if isAuthenticated();
      // Shopkeeper can update/delete their own products
      allow update, delete: if isAuthenticated() || isAdmin();
    }

    // 5. productPrivate (IMEI numbers for used phones - ADMIN ONLY)
    // Strictly hidden from customer view to comply with PECA anti-theft laws
    match /productPrivate/{productId} {
      allow read: if isAdmin();
      // Shopkeeper can write IMEI only when listing the product
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 6. Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      // Phone OTP verified user can leave review
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 7. Reports collection (Citizen reports)
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 8. Favorites collection
    match /favorites/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
